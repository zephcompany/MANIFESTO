<section
  class="manifesto-hero manifesto-hero--{{ section.settings.height }}{% if section.settings.mobile_image != blank %} manifesto-hero--has-mobile{% endif %}"
  data-section-id="{{ section.id }}"
>
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="manifesto-hero__link" aria-label="{{ section.settings.link_label | escape }}">
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 3000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'manifesto-hero__image manifesto-hero__image--desktop',
        widths: '750, 1100, 1500, 2000, 2500, 3000',
        sizes: '100vw',
        alt: section.settings.image.alt | default: section.settings.link_label | escape
    }}
  {%- else -%}
    <div class="manifesto-hero__placeholder manifesto-hero__image--desktop">
      <span>ADICIONE O BANNER PRINCIPAL</span>
    </div>
  {%- endif -%}

  {%- if section.settings.mobile_image != blank -%}
    {{
      section.settings.mobile_image
      | image_url: width: 1200
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'manifesto-hero__image manifesto-hero__image--mobile',
        widths: '375, 550, 750, 1000, 1200',
        sizes: '100vw',
        alt: section.settings.mobile_image.alt | default: section.settings.link_label | escape
    }}
  {%- endif -%}

  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</section>

<style>
  .manifesto-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f3f3f3;
  }

  .manifesto-hero--adapt { min-height: 0; }
  .manifesto-hero--small { height: clamp(330px, 43vw, 620px); }
  .manifesto-hero--medium { height: clamp(440px, 55vw, 780px); }
  .manifesto-hero--large { height: clamp(540px, 68vw, 920px); }

  .manifesto-hero__link { display: block; width: 100%; height: 100%; }

  .manifesto-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .manifesto-hero--adapt .manifesto-hero__image {
    height: auto;
    aspect-ratio: auto;
  }

  .manifesto-hero__image--mobile { display: none; }

  .manifesto-hero__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 520px;
    color: #7a7a7a;
    background:
      linear-gradient(135deg, rgba(0, 0, 0, 0.04) 25%, transparent 25%) -20px 0/40px 40px,
      linear-gradient(225deg, rgba(0, 0, 0, 0.04) 25%, transparent 25%) -20px 0/40px 40px,
      linear-gradient(315deg, rgba(0, 0, 0, 0.04) 25%, transparent 25%) 0 0/40px 40px,
      linear-gradient(45deg, rgba(0, 0, 0, 0.04) 25%, #f5f5f5 25%) 0 0/40px 40px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @media screen and (max-width: 749px) {
    .manifesto-hero--small,
    .manifesto-hero--medium,
    .manifesto-hero--large { height: min(132vw, 760px); }

    .manifesto-hero__image--mobile { display: block; }
    .manifesto-hero--has-mobile .manifesto-hero__image--desktop { display: none; }
    .manifesto-hero__placeholder { min-height: 520px; }
  }
</style>

{% schema %}
{
  "name": "Banner principal",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem desktop" },
    { "type": "image_picker", "id": "mobile_image", "label": "Imagem mobile" },
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "default": "medium",
      "options": [
        { "value": "adapt", "label": "Adaptar à imagem" },
        { "value": "small", "label": "Pequena" },
        { "value": "medium", "label": "Média" },
        { "value": "large", "label": "Grande" }
      ]
    },
    { "type": "url", "id": "link", "label": "Link do banner" },
    { "type": "text", "id": "link_label", "label": "Descrição do link", "default": "Ver coleção" }
  ],
  "presets": [{ "name": "Banner principal" }]
}
{% endschema %}
