
{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="manifesto-collection page-width" data-section-id="{{ section.id }}" style="--grid-columns: {{ section.settings.columns_desktop }};">
    <div class="manifesto-collection__toolbar">
      <div>
        <p class="manifesto-collection__count">{{ collection.products_count }} produtos</p>
      </div>

      {%- if section.settings.enable_sorting -%}
        <form method="get" class="manifesto-collection__sort">
          <label class="field__label" for="SortBy-{{ section.id }}">Ordenar por</label>
          <select name="sort_by" id="SortBy-{{ section.id }}" class="select__select" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>

    {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
      <form method="get" class="manifesto-collection__filters" id="CollectionFilters-{{ section.id }}">
        {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
        {%- for filter in collection.filters -%}
          <details class="manifesto-collection__filter">
            <summary>{{ filter.label | escape }}</summary>
            <div class="manifesto-collection__filter-content">
              {%- case filter.type -%}
                {%- when 'list', 'boolean' -%}
                  <ul class="manifesto-collection__filter-list" role="list">
                    {%- for value in filter.values -%}
                      <li>
                        <label>
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                          <span>{{ value.label | escape }}</span>
                          <small>({{ value.count }})</small>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="manifesto-collection__filter-price">
                    <input class="field__input" type="number" name="{{ filter.min_value.param_name }}" min="0" placeholder="De" {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}>
                    <input class="field__input" type="number" name="{{ filter.max_value.param_name }}" min="0" placeholder="Até" {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}>
                  </div>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
        <div class="manifesto-collection__filter-actions">
          <button type="submit" class="button">Aplicar</button>
          <a href="{{ collection.url }}" class="button button--secondary">Limpar</a>
        </div>
      </form>
    {%- endif -%}

    {%- if collection.products.size == 0 -%}
      <div class="manifesto-collection__empty">
        <p>Nenhum produto encontrado.</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">Ver todos os produtos</a>
      </div>
    {%- else -%}
      <ul class="manifesto-product-grid" role="list">
        {%- for product in collection.products -%}
          <li>{% render 'card-product', card_product: product %}</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </div>
{%- endpaginate -%}

<style>
  .manifesto-collection { padding-bottom: var(--spacing-sections, 48px); }
  .manifesto-collection__toolbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .manifesto-collection__count {
    margin: 0;
    color: #555;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .manifesto-collection__sort { display: flex; align-items: center; gap: 8px; }
  .manifesto-collection__sort .field__label { margin-bottom: 0; white-space: nowrap; }
  .manifesto-collection__sort .select__select { min-width: 220px; }
  .manifesto-collection__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 10px;
    margin-bottom: 28px;
  }
  .manifesto-collection__filter {
    border: 1px solid #dedede;
    background: #fff;
  }
  .manifesto-collection__filter summary {
    padding: 12px 14px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    list-style: none;
  }
  .manifesto-collection__filter summary::-webkit-details-marker { display: none; }
  .manifesto-collection__filter-content { padding: 0 14px 14px; min-width: 220px; }
  .manifesto-collection__filter-list { margin: 0; padding: 0; list-style: none; }
  .manifesto-collection__filter-list li + li { margin-top: 8px; }
  .manifesto-collection__filter-list label { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .manifesto-collection__filter-list small { color: #7b7b7b; }
  .manifesto-collection__filter-price { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .manifesto-collection__filter-actions { display: flex; gap: 8px; }
  .manifesto-collection__empty { padding: 70px 0; text-align: center; }
  .manifesto-collection .pagination { margin-top: 42px; }
  .manifesto-collection .pagination__list { display: flex; justify-content: center; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .manifesto-collection .pagination__item { display: grid; place-items: center; min-width: 42px; min-height: 42px; color: #000; border: 1px solid #ddd; text-decoration: none; }
  .manifesto-collection .pagination__item--current { border-color: #000; font-weight: 700; }
  @media screen and (max-width: 1000px) {
    .manifesto-collection__toolbar { align-items: stretch; flex-direction: column; }
    .manifesto-collection__sort { flex-direction: column; align-items: stretch; }
    .manifesto-collection__sort .select__select { min-width: 0; }
  }
</style>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 24, "step": 4, "default": 16, "label": "Produtos por página" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4, "label": "Colunas no desktop" },
    { "type": "checkbox", "id": "enable_sorting", "default": true, "label": "Mostrar ordenação" },
    { "type": "checkbox", "id": "enable_filtering", "default": true, "label": "Mostrar filtros" }
  ]
}
{% endschema %}
