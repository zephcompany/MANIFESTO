
{%- if section.settings.enable -%}
  <product-recommendations
    class="manifesto-related"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
  >
    {%- liquid
      assign related_products = recommendations.products
      if recommendations.performed and recommendations.products_count == 0
        assign fallback_collection = product.collections.first
        if fallback_collection and fallback_collection.products_count > 1
          assign related_products = fallback_collection.products
        endif
      endif
    -%}

    {%- if recommendations.performed -%}
      {%- assign rendered_count = 0 -%}
      <section class="manifesto-featured manifesto-featured--related">
        <div class="manifesto-featured__inner" style="--grid-columns: {{ section.settings.columns_desktop }};">
          <header class="manifesto-featured__header">
            <div>
              <p class="manifesto-featured__eyebrow">DESCUBRA MAIS</p>
              <h2 class="manifesto-featured__heading">{{ section.settings.heading | escape }}</h2>
              {%- if section.settings.text != blank -%}
                <p class="manifesto-featured__subheading">{{ section.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </header>

          <ul class="manifesto-product-grid" role="list">
            {%- for related_product in related_products -%}
              {%- if related_product.id != product.id and rendered_count < section.settings.products_to_show -%}
                <li>{% render 'card-product', card_product: related_product %}</li>
                {%- assign rendered_count = rendered_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </section>
    {%- endif -%}
  </product-recommendations>

  <style>
    .manifesto-related { padding-inline: clamp(16px, 3.2vw, 34px); }
    .manifesto-featured--related {
      padding: clamp(40px, 5vw, 72px) 0 clamp(70px, 8vw, 110px);
      border-top: 1px solid #ececec;
      margin-top: clamp(34px, 5vw, 58px);
    }
    .manifesto-featured__inner { width: 100%; max-width: 1440px; margin: 0 auto; }
    .manifesto-featured__eyebrow {
      margin: 0 0 10px;
      color: #666;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .manifesto-featured__header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: clamp(26px, 4vw, 44px);
    }
    .manifesto-featured__heading {
      margin: 0 0 8px;
      color: #000;
      font-size: clamp(28px, 4vw, 50px);
      font-weight: 800;
      line-height: .95;
      letter-spacing: -.035em;
      text-transform: uppercase;
    }
    .manifesto-featured__subheading { margin: 0; color: #666; font-size: 14px; line-height: 1.5; }
    .manifesto-product-grid {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns, 4), minmax(0, 1fr));
      gap: clamp(20px, 2.2vw, 36px);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    @media screen and (max-width: 1000px) {
      .manifesto-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    }
    @media screen and (max-width: 749px) {
      .manifesto-related { padding-inline: 20px; }
      .manifesto-featured__header { margin-bottom: 20px; }
      .manifesto-featured__heading { font-size: clamp(24px, 9vw, 40px); }
      .manifesto-featured__subheading { font-size: 13px; }
    }
  </style>

  <script>
    if (!customElements.get('product-recommendations')) {
      customElements.define('product-recommendations', class extends HTMLElement {
        connectedCallback() {
          var el = this;
          if (el.querySelector('.manifesto-product-grid')) return;
          fetch(el.dataset.url)
            .then(function (r) { return r.text(); })
            .then(function (text) {
              var html = document.createElement('div');
              html.innerHTML = text;
              var recos = html.querySelector('product-recommendations');
              if (recos && recos.innerHTML.trim().length) { el.innerHTML = recos.innerHTML; }
            })
            .catch(function (e) { console.error(e); });
        }
      });
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Produtos relacionados",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    { "type": "checkbox", "id": "enable", "default": true, "label": "Ativar seção" },
    { "type": "text", "id": "heading", "default": "Veja mais opções", "label": "Título" },
    { "type": "textarea", "id": "text", "default": "Mais frases e modelos para você continuar explorando.", "label": "Texto" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "default": 4, "label": "Produtos para mostrar" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4, "label": "Colunas no desktop" }
  ]
}
{% endschema %}
