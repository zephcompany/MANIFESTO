
<div class="manifesto-collection-banner page-width" data-section-id="{{ section.id }}">
  <div class="manifesto-collection-banner__text">
    <p class="manifesto-collection-banner__eyebrow">COLEÇÃO</p>
    <h1 class="manifesto-collection-banner__title">{{ collection.title }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="manifesto-collection-banner__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

<style>
  .manifesto-collection-banner {
    padding-top: clamp(42px, 6vw, 70px);
    padding-bottom: clamp(22px, 4vw, 36px);
    border-bottom: 1px solid #efefef;
  }
  .manifesto-collection-banner__text { max-width: 760px; }
  .manifesto-collection-banner__eyebrow {
    margin: 0 0 10px;
    color: #666;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .manifesto-collection-banner__title {
    margin: 0;
    font-size: clamp(34px, 6vw, 64px);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .manifesto-collection-banner__description {
    margin-top: 14px;
    color: #585858;
    font-size: 15px;
    line-height: 1.65;
  }
</style>

{% schema %}
{
  "name": "Cabeçalho da coleção",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    { "type": "checkbox", "id": "show_description", "default": true, "label": "Mostrar descrição" },
    { "type": "checkbox", "id": "show_image", "default": false, "label": "Mostrar imagem" }
  ]
}
{% endschema %}
