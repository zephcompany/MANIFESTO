<section class="manifesto-social-proof" data-section-id="{{ section.id }}">
  <div class="manifesto-social-proof__inner page-width">
    <div class="manifesto-social-proof__eyebrow">{{ section.settings.eyebrow | escape }}</div>
    <div class="manifesto-social-proof__content">
      <strong class="manifesto-social-proof__number">{{ section.settings.number | escape }}</strong>
      <div>
        <h2 class="manifesto-social-proof__title">{{ section.settings.heading | escape }}</h2>
        <p class="manifesto-social-proof__text">{{ section.settings.text | escape }}</p>
      </div>
    </div>

    <div class="manifesto-social-proof__reviews">
      <article class="manifesto-review-card">
        <div class="manifesto-review-card__stars">★★★★★</div>
        <p class="manifesto-review-card__text">"Chegou muito rápido e a qualidade da malha me surpreendeu. A estampa ficou ainda melhor ao vivo. Já quero pegar outras."</p>
        <div class="manifesto-review-card__footer">
          <strong class="manifesto-review-card__name">Lucas M.</strong>
          <span class="manifesto-review-card__badge">Compra verificada</span>
        </div>
      </article>

      <article class="manifesto-review-card">
        <div class="manifesto-review-card__stars">★★★★★</div>
        <p class="manifesto-review-card__text">"Curti muito o caimento e a proposta da marca. A camisa veste bem e passa uma pegada bem diferente do comum."</p>
        <div class="manifesto-review-card__footer">
          <strong class="manifesto-review-card__name">Bruna R.</strong>
          <span class="manifesto-review-card__badge">Compra verificada</span>
        </div>
      </article>

      <article class="manifesto-review-card">
        <div class="manifesto-review-card__stars">★★★★☆</div>
        <p class="manifesto-review-card__text">"Gostei bastante da experiência. Site fácil de usar, entrega no prazo e a camisa veio exatamente como nas fotos."</p>
        <div class="manifesto-review-card__footer">
          <strong class="manifesto-review-card__name">Rafael S.</strong>
          <span class="manifesto-review-card__badge">Compra verificada</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .manifesto-social-proof {
    padding: clamp(72px, 9vw, 130px) 0 0;
    color: #fff;
    background: #000;
  }
  .manifesto-social-proof__inner {
    display: grid;
    grid-template-columns: minmax(150px, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(35px, 7vw, 110px);
    align-items: start;
  }
  .manifesto-social-proof__eyebrow {
    padding-top: 12px;
    color: #a8a8a8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .manifesto-social-proof__content {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(28px, 5vw, 74px);
    align-items: center;
  }
  .manifesto-social-proof__number {
    color: #fff;
    font-family: var(--font-heading-family);
    font-size: clamp(78px, 12vw, 190px);
    font-weight: 800;
    line-height: 0.76;
    letter-spacing: -0.08em;
  }
  .manifesto-social-proof__title {
    max-width: 600px;
    margin: 0 0 13px;
    color: #fff;
    font-size: clamp(28px, 4vw, 55px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .manifesto-social-proof__text {
    max-width: 530px;
    margin: 0;
    color: #a8a8a8;
    font-size: 14px;
    line-height: 1.65;
  }
  .manifesto-social-proof__reviews {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    padding: 0 0 72px;
  }
  .manifesto-review-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 100%;
    padding: 28px;
    background: #0d0d0d;
    border: 1px solid #1f1f1f;
  }
  .manifesto-review-card__stars {
    color: #fff;
    font-size: 18px;
    letter-spacing: 0.18em;
    line-height: 1;
  }
  .manifesto-review-card__text {
    margin: 0;
    color: #ededed;
    font-size: 16px;
    line-height: 1.7;
  }
  .manifesto-review-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
  }
  .manifesto-review-card__name {
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .manifesto-review-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0 12px;
    color: #bfbfbf;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid #272727;
    background: #111;
  }

  @media screen and (max-width: 1000px) {
    .manifesto-social-proof__reviews { grid-template-columns: 1fr; }
  }

  @media screen and (max-width: 800px) {
    .manifesto-social-proof__inner { grid-template-columns: 1fr; gap: 30px; }
    .manifesto-social-proof__eyebrow { padding-top: 0; }
    .manifesto-social-proof__content { grid-template-columns: 1fr; gap: 26px; }
    .manifesto-social-proof__number { font-size: clamp(90px, 29vw, 150px); }
    .manifesto-social-proof__reviews { padding-bottom: 56px; }
    .manifesto-review-card { padding: 22px; }
    .manifesto-review-card__footer { align-items: flex-start; flex-direction: column; }
  }
</style>

{% schema %}
{
  "name": "Número e depoimentos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno", "default": "QUEM VESTE, MANIFESTA" },
    { "type": "text", "id": "number", "label": "Número", "default": "+720" },
    { "type": "text", "id": "heading", "label": "Título", "default": "CLIENTES SATISFEITOS" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Pessoas que escolheram vestir ideias grandes demais para ficar só na cabeça." }
  ],
  "presets": [{ "name": "Número e depoimentos" }]
}
{% endschema %}
