<section class="manifesto-cart page-width" id="main-cart-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="manifesto-cart__header">
    <div>
      <p class="manifesto-cart__eyebrow">SUA SELEÇÃO</p>
      <h1 class="manifesto-cart__title">Seu carrinho</h1>
    </div>
    {%- if cart.item_count > 0 -%}
      <p class="manifesto-cart__count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}itens{% endif %}</p>
    {%- endif -%}
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="manifesto-cart__empty">
      <h2>Seu carrinho está vazio</h2>
      <p>Escolha uma camiseta para continuar.</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">Ver camisetas</a>
    </div>
  {%- else -%}
    {%- form 'cart', cart, class: 'manifesto-cart__form' -%}
      <div class="manifesto-cart__layout">
        <div class="manifesto-cart__items">
          <div class="manifesto-cart__labels" aria-hidden="true">
            <span>Produto</span>
            <span>Quantidade</span>
            <span>Total</span>
          </div>

          {%- for item in cart.items -%}
            <article class="manifesto-cart-item" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="manifesto-cart-item__media">
                {%- if item.image -%}
                  {{
                    item.image
                    | image_url: width: 360
                    | image_tag:
                      loading: 'lazy',
                      widths: '120, 240, 360',
                      sizes: '(max-width: 749px) 92px, 130px',
                      class: 'manifesto-cart-item__image',
                      alt: item.image.alt | default: item.product.title | escape
                  }}
                {%- endif -%}
              </a>

              <div class="manifesto-cart-item__details">
                <a href="{{ item.url }}" class="manifesto-cart-item__title">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <div class="manifesto-cart-item__options">
                    {%- for option in item.options_with_values -%}
                      <span><strong>{{ option.name | escape }}:</strong> {{ option.value | escape }}</span>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}
                <p class="manifesto-cart-item__unit">{{ item.final_price | money }} cada</p>
                <a href="{{ item.url_to_remove }}" class="manifesto-cart-item__remove">Remover</a>
              </div>

              <div class="manifesto-cart-item__quantity">
                <label class="visually-hidden" for="Quantity-{{ forloop.index }}">Quantidade de {{ item.product.title | escape }}</label>
                <div class="quantity-selector">
                  <button type="button" class="quantity__button" name="minus" aria-label="Diminuir quantidade">−</button>
                  <input
                    class="quantity__input"
                    type="number"
                    name="updates[]"
                    id="Quantity-{{ forloop.index }}"
                    data-line="{{ forloop.index }}"
                    value="{{ item.quantity }}"
                    min="0"
                    step="1"
                    inputmode="numeric"
                  >
                  <button type="button" class="quantity__button" name="plus" aria-label="Aumentar quantidade">+</button>
                </div>
              </div>

              <div class="manifesto-cart-item__total">{{ item.final_line_price | money }}</div>
            </article>
          {%- endfor -%}
        </div>

        <aside class="manifesto-cart__summary">
          <h2>Resumo do pedido</h2>

          {%- if section.settings.show_note -%}
            <label class="manifesto-cart__note-label" for="Cart-note">Observações do pedido</label>
            <textarea class="manifesto-cart__note field__input" name="note" id="Cart-note" rows="3" placeholder="Escreva uma observação, se precisar.">{{ cart.note }}</textarea>
          {%- endif -%}

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="manifesto-cart__discounts">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="manifesto-cart__subtotal">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>

          <p class="manifesto-cart__shipping">Frete e descontos são calculados na finalização da compra.</p>

          <button type="submit" name="checkout" class="button manifesto-cart__checkout">Finalizar compra</button>
          <button type="submit" name="update" class="button button--secondary manifesto-cart__update">Atualizar carrinho</button>
          <a href="{{ routes.all_products_collection_url }}" class="manifesto-cart__continue">Continuar comprando</a>

          <div class="manifesto-cart__trust">
            <span>Pagamento seguro</span>
            <span>Troca facilitada</span>
            <span>Envio com rastreio</span>
          </div>
        </aside>
      </div>
    {%- endform -%}
  {%- endif -%}
</section>

<style>
  .manifesto-cart { padding-top: clamp(48px, 7vw, 90px); padding-bottom: clamp(64px, 8vw, 110px); }
  .manifesto-cart__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 26px;
    border-bottom: 1px solid #e5e5e5;
  }
  .manifesto-cart__eyebrow { margin: 0 0 9px; color: #6c6c6c; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .manifesto-cart__title { margin: 0; font-size: clamp(38px, 6vw, 70px); line-height: .92; letter-spacing: -.04em; text-transform: uppercase; }
  .manifesto-cart__count { margin: 0; color: #555; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  .manifesto-cart__empty { max-width: 580px; margin: 70px auto 0; text-align: center; }
  .manifesto-cart__empty h2 { margin: 0 0 12px; font-size: clamp(28px, 4vw, 44px); text-transform: uppercase; }
  .manifesto-cart__empty p { margin: 0 0 26px; color: #666; }
  .manifesto-cart__layout { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(330px, .65fr); gap: clamp(34px, 5vw, 72px); padding-top: 34px; }
  .manifesto-cart__labels { display: grid; grid-template-columns: minmax(0, 1fr) 150px 120px; gap: 20px; padding: 0 0 14px; color: #777; border-bottom: 1px solid #e5e5e5; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .manifesto-cart__labels span:nth-child(2), .manifesto-cart__labels span:nth-child(3) { text-align: right; }
  .manifesto-cart-item { display: grid; grid-template-columns: 130px minmax(0, 1fr) 150px 120px; align-items: center; gap: 20px; padding: 24px 0; border-bottom: 1px solid #e5e5e5; }
  .manifesto-cart-item__media { display: block; overflow: hidden; background: #f3f3f3; }
  .manifesto-cart-item__image { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .manifesto-cart-item__title { display: inline-block; color: #000; font-size: 15px; font-weight: 700; line-height: 1.35; text-decoration: none; text-transform: uppercase; }
  .manifesto-cart-item__options { display: flex; flex-wrap: wrap; gap: 7px 14px; margin-top: 9px; color: #666; font-size: 12px; }
  .manifesto-cart-item__options strong { color: #333; }
  .manifesto-cart-item__unit { margin: 8px 0 0; color: #666; font-size: 12px; }
  .manifesto-cart-item__remove { display: inline-block; margin-top: 12px; color: #000; font-size: 11px; text-decoration: underline; }
  .manifesto-cart-item__quantity { justify-self: end; }
  .manifesto-cart-item .quantity-selector { display: inline-flex; align-items: center; border: 1px solid #d6d6d6; }
  .manifesto-cart-item .quantity__button { width: 40px; height: 42px; color: #000; background: #fff; border: 0; cursor: pointer; font-size: 20px; }
  .manifesto-cart-item .quantity__input { width: 48px; height: 42px; color: #000; background: #fff; border: 0; text-align: center; font-size: 14px; -moz-appearance: textfield; }
  .manifesto-cart-item .quantity__input::-webkit-outer-spin-button,
  .manifesto-cart-item .quantity__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .manifesto-cart-item__total { justify-self: end; font-size: 16px; font-weight: 700; white-space: nowrap; }
  .manifesto-cart__summary { position: sticky; top: 24px; padding: 26px; background: #f5f5f5; border: 1px solid #e6e6e6; }
  .manifesto-cart__summary h2 { margin: 0 0 24px; font-size: 22px; text-transform: uppercase; }
  .manifesto-cart__note-label { display: block; margin-bottom: 8px; font-size: 12px; font-weight: 700; }
  .manifesto-cart__note { resize: vertical; margin-bottom: 22px; background: #fff; }
  .manifesto-cart__discounts { margin: 0 0 16px; padding: 0; list-style: none; font-size: 13px; }
  .manifesto-cart__discounts li { display: flex; justify-content: space-between; gap: 12px; }
  .manifesto-cart__subtotal { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 18px 0; border-top: 1px solid #d7d7d7; border-bottom: 1px solid #d7d7d7; font-size: 17px; }
  .manifesto-cart__subtotal strong { font-size: 24px; }
  .manifesto-cart__shipping { margin: 14px 0 22px; color: #666; font-size: 12px; line-height: 1.55; }
  .manifesto-cart__checkout, .manifesto-cart__update { width: 100%; min-height: 54px; }
  .manifesto-cart__update { margin-top: 10px; }
  .manifesto-cart__continue { display: block; margin-top: 18px; color: #000; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-align: center; text-transform: uppercase; }
  .manifesto-cart__trust { display: grid; gap: 10px; margin-top: 24px; padding-top: 20px; border-top: 1px solid #d7d7d7; color: #444; font-size: 12px; }
  .manifesto-cart__trust span::before { content: '✓'; margin-right: 8px; font-weight: 800; }

  @media screen and (max-width: 1000px) {
    .manifesto-cart__layout { grid-template-columns: 1fr; }
    .manifesto-cart__summary { position: static; }
  }
  @media screen and (max-width: 749px) {
    .manifesto-cart__header { align-items: flex-start; flex-direction: column; }
    .manifesto-cart__labels { display: none; }
    .manifesto-cart-item { grid-template-columns: 92px minmax(0, 1fr); align-items: start; gap: 14px; }
    .manifesto-cart-item__quantity { grid-column: 2; justify-self: start; }
    .manifesto-cart-item__total { grid-column: 2; justify-self: start; }
    .manifesto-cart__summary { padding: 22px 18px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('main-cart-{{ section.id }}');
    if (!root) return;

    function changeLine(line, quantity) {
      fetch('{{ routes.cart_change_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ line: line, quantity: quantity })
      })
        .then(function () { window.location.reload(); })
        .catch(function () { window.location.reload(); });
    }

    root.addEventListener('click', function (event) {
      var button = event.target.closest('.quantity__button');
      if (!button) return;
      event.preventDefault();
      var input = button.parentElement.querySelector('.quantity__input');
      if (!input) return;
      var current = parseInt(input.value, 10) || 0;
      var next = button.name === 'plus' ? current + 1 : Math.max(0, current - 1);
      changeLine(parseInt(input.dataset.line, 10), next);
    });

    root.addEventListener('change', function (event) {
      var input = event.target.closest('.quantity__input');
      if (!input) return;
      changeLine(parseInt(input.dataset.line, 10), Math.max(0, parseInt(input.value, 10) || 0));
    });
  })();
</script>

{% schema %}
{
  "name": "Carrinho",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "default": true, "label": "Mostrar observações do pedido" }
  ]
}
{% endschema %}
