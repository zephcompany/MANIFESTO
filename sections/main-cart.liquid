
<section class="manifesto-cart page-width" id="main-cart-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="manifesto-cart__header">
    <div>
      <p class="manifesto-cart__eyebrow">SUA SELEÇÃO</p>
      <h1 class="manifesto-cart__title">Seu carrinho</h1>
      <p class="manifesto-cart__subtitle">Revise seus itens antes de finalizar a compra.</p>
    </div>
    {%- if cart.item_count > 0 -%}
      <span class="manifesto-cart__count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}itens{% endif %}</span>
    {%- endif -%}
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="manifesto-cart__empty">
      <h2>Seu carrinho está vazio</h2>
      <p>Escolha uma camiseta para continuar.</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">Ver camisetas</a>
    </div>
  {%- else -%}
    {%- form 'cart', cart, class: 'manifesto-cart__form' -%}
      <div class="manifesto-cart__layout">
        <div class="manifesto-cart__items-wrap">
          <div class="manifesto-cart__items-grid">
            {%- for item in cart.items -%}
              <article class="manifesto-cart-card" data-line="{{ forloop.index }}">
                <a href="{{ item.url }}" class="manifesto-cart-card__media">
                  {%- if item.image -%}
                    {{
                      item.image
                      | image_url: width: 520
                      | image_tag:
                        loading: 'lazy',
                        widths: '180, 260, 360, 520',
                        sizes: '(max-width: 749px) 50vw, (max-width: 1200px) 28vw, 20vw',
                        class: 'manifesto-cart-card__image',
                        alt: item.image.alt | default: item.product.title | escape
                    }}
                  {%- endif -%}
                </a>

                <div class="manifesto-cart-card__body">
                  <a href="{{ item.url }}" class="manifesto-cart-card__title">{{ item.product.title | escape }}</a>

                  {%- unless item.product.has_only_default_variant -%}
                    <div class="manifesto-cart-card__options">
                      {%- for option in item.options_with_values -%}
                        <span>{{ option.name | escape }}: {{ option.value | escape }}</span>
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}

                  <div class="manifesto-cart-card__price-line">
                    {%- if item.original_line_price > item.final_line_price -%}
                      <s>{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                    <strong>{{ item.final_line_price | money }}</strong>
                  </div>
                  <p class="manifesto-cart-card__unit">{{ item.final_price | money }} cada</p>

                  <div class="manifesto-cart-card__footer">
                    <div class="manifesto-cart-card__quantity">
                      <label class="visually-hidden" for="Quantity-{{ forloop.index }}">Quantidade de {{ item.product.title | escape }}</label>
                      <div class="quantity-selector">
                        <button type="button" class="quantity__button" name="minus" aria-label="Diminuir quantidade">−</button>
                        <input
                          class="quantity__input"
                          type="number"
                          name="updates[]"
                          id="Quantity-{{ forloop.index }}"
                          data-line="{{ forloop.index }}"
                          value="{{ item.quantity }}"
                          min="0"
                          step="1"
                          inputmode="numeric"
                        >
                        <button type="button" class="quantity__button" name="plus" aria-label="Aumentar quantidade">+</button>
                      </div>
                    </div>

                    <a href="{{ item.url_to_remove }}" class="manifesto-cart-card__remove">Remover</a>
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>

        <aside class="manifesto-cart__summary">
          <div class="manifesto-cart__summary-head">
            <p class="manifesto-cart__summary-eyebrow">Resumo</p>
            <h2>Resumo do pedido</h2>
          </div>

          {%- if section.settings.show_note -%}
            <label class="manifesto-cart__note-label" for="Cart-note">Observações do pedido</label>
            <textarea class="manifesto-cart__note field__input" name="note" id="Cart-note" rows="3" placeholder="Escreva uma observação, se precisar.">{{ cart.note }}</textarea>
          {%- endif -%}

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="manifesto-cart__discounts">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="manifesto-cart__line">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <div class="manifesto-cart__line manifesto-cart__line--muted">
            <span>Frete</span>
            <span>Calculado no checkout</span>
          </div>

          <p class="manifesto-cart__shipping">Você ainda poderá revisar endereço, frete e pagamento antes de concluir.</p>

          <button type="submit" name="checkout" class="button manifesto-cart__checkout">Finalizar compra</button>
          <button type="submit" name="update" class="button button--secondary manifesto-cart__update">Atualizar carrinho</button>
          <a href="{{ routes.all_products_collection_url }}" class="manifesto-cart__continue">Continuar comprando</a>

          <div class="manifesto-cart__trust">
            <span>Pagamento seguro</span>
            <span>Troca facilitada</span>
            <span>Envio com rastreio</span>
          </div>
        </aside>
      </div>
    {%- endform -%}
  {%- endif -%}
</section>

<style>
  .manifesto-cart { padding-top: clamp(42px, 7vw, 84px); padding-bottom: clamp(64px, 8vw, 110px); }
  .manifesto-cart__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 26px;
    border-bottom: 1px solid #ececec;
  }
  .manifesto-cart__eyebrow { margin: 0 0 9px; color: #7a7a7a; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .manifesto-cart__title { margin: 0; font-size: clamp(38px, 6vw, 68px); line-height: .92; letter-spacing: -.04em; text-transform: uppercase; }
  .manifesto-cart__subtitle { margin: 12px 0 0; color: #666; font-size: 14px; }
  .manifesto-cart__count {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 16px;
    color: #000; background: #f5f5f5; border: 1px solid #e5e5e5; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  }
  .manifesto-cart__empty { max-width: 580px; margin: 70px auto 0; text-align: center; }
  .manifesto-cart__empty h2 { margin: 0 0 12px; font-size: clamp(28px, 4vw, 44px); text-transform: uppercase; }
  .manifesto-cart__empty p { margin: 0 0 26px; color: #666; }
  .manifesto-cart__layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(320px, .72fr); gap: clamp(24px, 4vw, 42px); padding-top: 32px; }
  .manifesto-cart__items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
  }
  .manifesto-cart-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e6e6e6;
  }
  .manifesto-cart-card__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f4f4f4;
  }
  .manifesto-cart-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .manifesto-cart-card__body { display: flex; flex: 1; flex-direction: column; padding: 16px; }
  .manifesto-cart-card__title {
    color: #000; font-size: 14px; font-weight: 700; line-height: 1.35; text-decoration: none; text-transform: uppercase;
  }
  .manifesto-cart-card__options { display: grid; gap: 4px; margin-top: 8px; color: #666; font-size: 11px; }
  .manifesto-cart-card__price-line { display: flex; align-items: baseline; gap: 8px; margin-top: 10px; }
  .manifesto-cart-card__price-line s { color: #8a8a8a; font-size: 12px; }
  .manifesto-cart-card__price-line strong { font-size: 20px; line-height: 1; }
  .manifesto-cart-card__unit { margin: 6px 0 0; color: #666; font-size: 11px; }
  .manifesto-cart-card__footer { display: grid; gap: 12px; margin-top: auto; padding-top: 16px; }
  .manifesto-cart-card .quantity-selector { display: inline-flex; align-items: center; overflow: hidden; border: 1px solid #d7d7d7; }
  .manifesto-cart-card .quantity__button { width: 38px; height: 40px; color: #000; background: #fff; border: 0; cursor: pointer; font-size: 20px; }
  .manifesto-cart-card .quantity__input { width: 46px; height: 40px; color: #000; background: #fff; border: 0; text-align: center; font-size: 14px; -moz-appearance: textfield; }
  .manifesto-cart-card .quantity__input::-webkit-outer-spin-button,
  .manifesto-cart-card .quantity__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .manifesto-cart-card__remove { color: #000; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; text-decoration: underline; }
  .manifesto-cart__summary {
    position: sticky; top: 22px; align-self: start; padding: 28px;
    background: linear-gradient(180deg, #f9f9f9 0%, #f2f2f2 100%); border: 1px solid #e7e7e7;
  }
  .manifesto-cart__summary-head { margin-bottom: 18px; }
  .manifesto-cart__summary-eyebrow { margin: 0 0 8px; color: #6a6a6a; font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .manifesto-cart__summary h2 { margin: 0; font-size: 30px; line-height: .98; text-transform: uppercase; }
  .manifesto-cart__note-label { display: block; margin-bottom: 8px; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .manifesto-cart__note { resize: vertical; min-height: 92px; margin-bottom: 18px; background: #fff; }
  .manifesto-cart__discounts { margin: 0 0 16px; padding: 0; list-style: none; font-size: 13px; }
  .manifesto-cart__discounts li { display: flex; justify-content: space-between; gap: 12px; }
  .manifesto-cart__line { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 12px 0; border-top: 1px solid #dddddd; }
  .manifesto-cart__line strong { font-size: 26px; }
  .manifesto-cart__line--muted { color: #666; font-size: 13px; }
  .manifesto-cart__shipping { margin: 14px 0 22px; color: #666; font-size: 12px; line-height: 1.6; }
  .manifesto-cart__checkout, .manifesto-cart__update { width: 100%; min-height: 54px; }
  .manifesto-cart__update { margin-top: 10px; }
  .manifesto-cart__continue { display: block; margin-top: 16px; color: #000; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-align: center; text-transform: uppercase; text-decoration: none; }
  .manifesto-cart__trust { display: grid; gap: 10px; margin-top: 22px; padding-top: 20px; border-top: 1px solid #dcdcdc; color: #555; font-size: 13px; }
  .manifesto-cart__trust span::before { content: '✓'; margin-right: 8px; color: #000; }

  @media screen and (min-width: 1500px) {
    .manifesto-cart__items-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 1200px) {
    .manifesto-cart__items-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 1050px) {
    .manifesto-cart__layout { grid-template-columns: 1fr; }
    .manifesto-cart__summary { position: static; }
  }
  @media screen and (max-width: 749px) {
    .manifesto-cart__header { align-items: flex-start; flex-direction: column; }
    .manifesto-cart__items-grid { grid-template-columns: 1fr; }
    .manifesto-cart__summary { padding: 22px 18px; }
    .manifesto-cart__summary h2 { font-size: 24px; }
    .manifesto-cart__line strong { font-size: 22px; }
  }
</style>

<script>
  (function () {
    var container = document.getElementById('main-cart-{{ section.id }}');
    if (!container) return;
    container.querySelectorAll('.quantity-selector').forEach(function (selector) {
      var input = selector.querySelector('.quantity__input');
      var minus = selector.querySelector('[name="minus"]');
      var plus = selector.querySelector('[name="plus"]');
      if (!input) return;
      function update(delta) {
        var current = parseInt(input.value || '0', 10);
        var next = Math.max(0, current + delta);
        input.value = next;
      }
      if (minus) minus.addEventListener('click', function () { update(-1); });
      if (plus) plus.addEventListener('click', function () { update(1); });
    });
  })();
</script>

{% schema %}
{
  "name": "Carrinho principal",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Mostrar observações do pedido", "default": true }
  ]
}
{% endschema %}
