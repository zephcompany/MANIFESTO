<footer class="manifesto-footer" data-section-id="{{ section.id }}">
  <div class="manifesto-footer__top page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="manifesto-footer__block manifesto-footer__brand" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {{
                block.settings.logo
                | image_url: width: 500
                | image_tag:
                  class: 'manifesto-footer__logo',
                  widths: '180, 300, 500',
                  width: 220,
                  alt: shop.name | escape
              }}
            {%- elsif settings.logo != blank -%}
              {{
                settings.logo
                | image_url: width: 500
                | image_tag:
                  class: 'manifesto-footer__logo manifesto-footer__logo--theme',
                  widths: '180, 300, 500',
                  width: 220,
                  alt: shop.name | escape
              }}
            {%- else -%}
              <img src="{{ 'manifesto-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" class="manifesto-footer__logo" loading="lazy" width="260" height="70">
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="manifesto-footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'menu' -%}
          <div class="manifesto-footer__block" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="manifesto-footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="manifesto-footer__menu" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="manifesto-footer__link">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <ul class="manifesto-footer__menu" role="list">
                <li><a href="{{ routes.root_url }}" class="manifesto-footer__link">Início</a></li>
                <li><a href="{{ routes.all_products_collection_url }}" class="manifesto-footer__link">Camisetas</a></li>
                <li><a href="/pages/rastreie-seu-pedido" class="manifesto-footer__link">Rastreie seu pedido</a></li>
                <li><a href="/pages/contato" class="manifesto-footer__link">Entre em contato</a></li>
              </ul>
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          <div class="manifesto-footer__block" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="manifesto-footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="manifesto-footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'newsletter' -%}
          <div class="manifesto-footer__block manifesto-footer__newsletter" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="manifesto-footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="manifesto-footer__newsletter-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {% render 'newsletter-form', block: block %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="manifesto-footer__middle page-width">
    <span>{{ section.settings.manifesto_text | escape }}</span>
  </div>

  <div class="manifesto-footer__bottom page-width">
    <div class="manifesto-footer__bottom-left">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos os direitos reservados.</p>

      {%- if section.settings.show_social -%}
        <ul class="manifesto-footer__social" role="list">
          {%- if settings.social_instagram_link != blank -%}
            <li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="manifesto-footer__payment" role="list" aria-label="Formas de pagamento">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'manifesto-footer__payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

<style>
  .manifesto-footer {
    margin-top: 0;
    color: #fff;
    background: #000;
  }

  .manifesto-footer__top {
    display: grid;
    grid-template-columns: 1.25fr 0.65fr 0.75fr 1.35fr;
    gap: clamp(35px, 6vw, 90px);
    padding-top: clamp(70px, 8vw, 115px);
    padding-bottom: clamp(60px, 7vw, 95px);
  }

  .manifesto-footer__logo {
    display: block;
    width: auto;
    max-width: 220px;
    height: auto;
    max-height: 60px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .manifesto-footer__brand-name {
    margin: 0 0 25px;
    color: #fff;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .manifesto-footer__heading {
    margin: 0 0 24px;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .manifesto-footer__menu { margin: 0; padding: 0; list-style: none; }

  .manifesto-footer__link {
    display: inline-block;
    padding: 7px 0;
    color: #a8a8a8;
    font-size: 13px;
    line-height: 1.4;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .manifesto-footer__link:hover { color: #fff; }

  .manifesto-footer__text,
  .manifesto-footer__newsletter-text {
    max-width: 330px;
    margin: 0;
    color: #9f9f9f;
    font-size: 13px;
    line-height: 1.65;
  }

  .manifesto-footer__newsletter-text { margin-bottom: 20px; }

  .manifesto-footer .newsletter-form__field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0;
    border-bottom: 1px solid #fff;
  }

  .manifesto-footer .newsletter-form__field .field__input {
    min-width: 0;
    padding: 14px 0;
    color: #fff;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .manifesto-footer .newsletter-form__field .field__input::placeholder { color: #777; }

  .manifesto-footer .newsletter-form__button {
    min-height: 44px;
    padding: 8px 0 8px 20px;
    color: #fff;
    background: transparent;
    border: 0;
    border-radius: 0;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .manifesto-footer__middle {
    padding-top: 25px;
    padding-bottom: 25px;
    border-top: 1px solid #222;
    border-bottom: 1px solid #222;
    overflow: hidden;
  }

  .manifesto-footer__middle span {
    display: block;
    color: #fff;
    font-family: var(--font-heading-family);
    font-size: clamp(37px, 7.6vw, 118px);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.055em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .manifesto-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding-top: 25px;
    padding-bottom: 25px;
    color: #777;
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .manifesto-footer__bottom-left { display: flex; align-items: center; gap: 22px; }
  .manifesto-footer__social { display: flex; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .manifesto-footer__social a { display: inline-flex; color: #fff; }
  .manifesto-footer__social svg { width: 18px; height: 18px; }

  .manifesto-footer__payment {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
    filter: grayscale(1) brightness(1.7);
  }

  .manifesto-footer__payment-icon { width: 35px; height: 22px; }

  @media screen and (max-width: 1000px) {
    .manifesto-footer__top { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 620px) {
    .manifesto-footer__top { grid-template-columns: 1fr; gap: 45px; }
    .manifesto-footer__middle span { font-size: 41px; }
    .manifesto-footer__bottom { align-items: flex-start; flex-direction: column; }
    .manifesto-footer__bottom-left { align-items: flex-start; flex-direction: column; gap: 14px; }
    .manifesto-footer__payment { justify-content: flex-start; flex-wrap: wrap; }
  }
</style>

{% schema %}
{
  "name": "Rodapé Manifesto",
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo branca" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Frases que não pedem licença. Vista o que você pensa.</p>" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Navegação" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Atendimento" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Segunda a sexta, das 9h às 18h. Fale com a gente pela página de contato.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Receba os próximos drops" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Novas frases, lançamentos e condições exclusivas direto no seu e-mail." }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "manifesto_text", "label": "Texto grande", "default": "VISTA O QUE VOCÊ PENSA." },
    { "type": "checkbox", "id": "show_social", "default": true, "label": "Mostrar redes sociais" },
    { "type": "checkbox", "id": "show_payment_icons", "default": true, "label": "Mostrar formas de pagamento" }
  ],
  "presets": [
    {
      "name": "Rodapé Manifesto",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "text" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
