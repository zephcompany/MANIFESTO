{%- assign form_id = 'ContactForm-' | append: section.id -%}
<section class="manifesto-contact" id="contato" data-section-id="{{ section.id }}">
  <div class="manifesto-contact__inner page-width">
    <header class="manifesto-contact__header">
      <p class="manifesto-contact__eyebrow">FALE COM A MANIFESTO</p>
      <h1 class="manifesto-contact__heading">{{ section.settings.heading | default: 'Entre em contato' | escape }}</h1>
      <p class="manifesto-contact__text">Preencha o formulário e nossa equipe responde assim que possível.</p>
    </header>

    {%- form 'contact', id: form_id, class: 'manifesto-contact__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="manifesto-contact__notice manifesto-contact__notice--success" role="status" tabindex="-1">
          Mensagem enviada com sucesso. Em breve entraremos em contato.
        </div>
      {%- elsif form.errors -%}
        <div class="manifesto-contact__notice manifesto-contact__notice--error" role="alert" tabindex="-1">
          Confira os campos abaixo e tente novamente.
        </div>
      {%- endif -%}

      <div class="manifesto-contact__grid">
        <div class="manifesto-contact__field">
          <label for="ContactForm-name-{{ section.id }}">Nome</label>
          <input type="text" class="field__input" id="ContactForm-name-{{ section.id }}" name="contact[nome]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
        </div>
        <div class="manifesto-contact__field">
          <label for="ContactForm-email-{{ section.id }}">E-mail</label>
          <input type="email" class="field__input" id="ContactForm-email-{{ section.id }}" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
        </div>
        <div class="manifesto-contact__field">
          <label for="ContactForm-phone-{{ section.id }}">WhatsApp</label>
          <input type="tel" class="field__input" id="ContactForm-phone-{{ section.id }}" name="contact[telefone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" autocomplete="tel">
        </div>
        <div class="manifesto-contact__field">
          <label for="ContactForm-subject-{{ section.id }}">Assunto</label>
          <input type="text" class="field__input" id="ContactForm-subject-{{ section.id }}" name="contact[assunto]" placeholder="Como podemos ajudar?">
        </div>
      </div>

      <div class="manifesto-contact__field">
        <label for="ContactForm-body-{{ section.id }}">Mensagem</label>
        <textarea rows="7" class="field__input manifesto-contact__textarea" id="ContactForm-body-{{ section.id }}" name="contact[body]" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </div>

      <button type="submit" class="button manifesto-contact__submit">Enviar mensagem</button>
    {%- endform -%}
  </div>
</section>

<style>
  .manifesto-contact { padding: clamp(70px, 9vw, 120px) 0; background: #fff; }
  .manifesto-contact__inner { display: grid; grid-template-columns: minmax(260px, .7fr) minmax(0, 1.3fr); gap: clamp(42px, 7vw, 110px); align-items: start; }
  .manifesto-contact__eyebrow { margin: 0 0 12px; color: #666; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .manifesto-contact__heading { margin: 0 0 18px; font-size: clamp(38px, 6vw, 70px); line-height: .92; letter-spacing: -.04em; text-transform: uppercase; }
  .manifesto-contact__text { max-width: 390px; margin: 0; color: #666; font-size: 14px; line-height: 1.65; }
  .manifesto-contact__form { padding: 28px; border: 1px solid #e2e2e2; background: #fafafa; }
  .manifesto-contact__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .manifesto-contact__field { margin-bottom: 18px; }
  .manifesto-contact__field label { display: block; margin-bottom: 7px; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .manifesto-contact__textarea { resize: vertical; min-height: 160px; }
  .manifesto-contact__submit { width: 100%; min-height: 54px; }
  .manifesto-contact__notice { margin-bottom: 20px; padding: 14px 16px; font-size: 13px; }
  .manifesto-contact__notice--success { color: #fff; background: #000; }
  .manifesto-contact__notice--error { color: #000; border: 1px solid #000; background: #fff; }
  @media screen and (max-width: 850px) {
    .manifesto-contact__inner { grid-template-columns: 1fr; }
    .manifesto-contact__grid { grid-template-columns: 1fr; gap: 0; }
    .manifesto-contact__form { padding: 20px 16px; }
  }
</style>

{% schema %}
{
  "name": "Formulário de contato",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Entre em contato" }
  ],
  "presets": [{ "name": "Formulário de contato" }]
}
{% endschema %}
