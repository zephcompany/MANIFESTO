
{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show | plus: 0
  assign total_products = collection.all_products_count | plus: 0
-%}

<section class="manifesto-featured" data-section-id="{{ section.id }}">
  <div class="manifesto-featured__inner page-width" style="--grid-columns: {{ section.settings.columns_desktop }};">
    <header class="manifesto-featured__header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="manifesto-featured__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="manifesto-featured__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and section.settings.show_all_products == false and total_products > limit -%}
        <a href="{{ collection.url }}" class="manifesto-featured__view-all">VER TODAS</a>
      {%- endif -%}
    </header>

    {%- if collection.products.size > 0 -%}
      <ul class="manifesto-product-grid" role="list">
        {%- if section.settings.show_all_products -%}
          {%- for product in collection.products -%}
            <li>{% render 'card-product', card_product: product, pix_discount: section.settings.pix_discount %}</li>
          {%- endfor -%}
        {%- else -%}
          {%- for product in collection.products limit: limit -%}
            <li>{% render 'card-product', card_product: product, pix_discount: section.settings.pix_discount %}</li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- else -%}
      <ul class="manifesto-product-grid" role="list">
        {%- for i in (1..limit) -%}
          {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
          {%- assign placeholder_name = 'product-' | append: placeholder_index -%}
          <li>
            <article class="manifesto-product-card manifesto-product-card--placeholder">
              <div class="manifesto-product-card__media" style="--card-ratio: 0.8;">
                {{ placeholder_name | placeholder_svg_tag: 'manifesto-product-card__image placeholder-svg' }}
              </div>
              <div class="manifesto-product-card__content">
                <h3 class="manifesto-product-card__title">CAMISETA MANIFESTO</h3>
                <div class="manifesto-product-card__price-row">
                  <s class="manifesto-product-card__compare">R$ 129,90</s>
                  <span class="manifesto-product-card__price">R$ 99,90</span>
                </div>
                <p class="manifesto-product-card__pix"><strong>R$ 94,90</strong> no Pix <span>5% OFF</span></p>
                <div class="manifesto-product-card__swatches">
                  <span class="manifesto-product-card__swatch" style="--swatch:#111"></span>
                  <span class="manifesto-product-card__swatch" style="--swatch:#fff"></span>
                </div>
                <span class="manifesto-product-card__button">COMPRAR</span>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  .manifesto-featured {
    padding: clamp(70px, 8vw, 120px) 0;
    background: #fff;
  }
  .manifesto-featured__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(34px, 4vw, 56px);
  }
  .manifesto-featured__heading {
    margin: 0 0 9px;
    color: #000;
    font-size: clamp(28px, 4vw, 50px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .manifesto-featured__subheading {
    margin: 0;
    color: #666;
    font-size: 14px;
    line-height: 1.5;
  }
  .manifesto-featured__view-all {
    flex: 0 0 auto;
    padding-bottom: 7px;
    color: #000;
    border-bottom: 1px solid #000;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .manifesto-product-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns, 4), minmax(0, 1fr));
    gap: clamp(20px, 2.2vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media screen and (max-width: 1000px) {
    .manifesto-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .manifesto-featured__header { align-items: flex-start; flex-direction: column; }
  }
</style>

{% schema %}
{
  "name": "Coleção em destaque",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "MAIS VENDIDAS" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Confira as escolhas mais populares do momento." },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "checkbox", "id": "show_all_products", "label": "Mostrar todos os produtos", "default": true },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "default": 8, "label": "Produtos para mostrar" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4, "label": "Colunas no desktop" },
    { "type": "range", "id": "pix_discount", "min": 0, "max": 20, "step": 1, "default": 5, "label": "Desconto no Pix (%)" },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar link ver todas", "default": false }
  ],
  "presets": [{ "name": "Coleção em destaque" }]
}
{% endschema %}
