{%- liquid
  assign manifesto_contact_page = pages['contato']
  if manifesto_contact_page == blank
    assign manifesto_contact_page = pages['contact']
  endif
  if manifesto_contact_page != blank
    assign manifesto_contact_url = manifesto_contact_page.url
  else
    assign manifesto_contact_url = routes.root_url | append: '#contato'
  endif
-%}

<div class="manifesto-header-wrapper" data-section-id="{{ section.id }}">
  {%- if section.settings.show_top_bar -%}
    <div class="manifesto-topbar" aria-label="Informações da loja">
      <div class="manifesto-topbar__track">
        {%- assign items = section.settings.top_bar_text | split: '|' -%}
        {%- for repeat in (1..2) -%}
          {%- for item in items -%}
            {%- assign clean_item = item | strip -%}
            {%- if clean_item != blank -%}
              <span class="manifesto-topbar__item{% if repeat == 2 %} is-clone{% endif %}">
                {{ clean_item | escape }}
                <span class="manifesto-topbar__dot">✦</span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <header class="manifesto-header">
    <div class="manifesto-header__inner page-width">
      <button
        type="button"
        class="manifesto-header__menu-toggle tap-target"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="MobileNav-{{ section.id }}"
      >
        <span class="manifesto-header__burger"></span>
      </button>

      <nav class="manifesto-header__nav" aria-label="Navegação principal">
        <ul class="manifesto-header__menu" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- assign manifesto_label_downcase = block.settings.label | downcase -%}
            {%- assign manifesto_item_url = block.settings.link | default: routes.root_url -%}
            {%- if manifesto_label_downcase contains 'contato' -%}
              {%- assign manifesto_item_url = manifesto_contact_url -%}
            {%- endif -%}
            <a href="{{ manifesto_item_url }}" class="manifesto-header__menu-link">
              {{ block.settings.label | escape }}
            </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <a href="{{ routes.root_url }}" class="manifesto-header__logo-link" aria-label="{{ shop.name | escape }}">
        <img
          src="{{ 'manifesto-logo.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="manifesto-header__logo-image"
          loading="eager"
          width="260"
          height="88"
        >
      </a>

      <div class="manifesto-header__actions">
        <details class="manifesto-header__search">
          <summary class="manifesto-header__action tap-target" aria-label="Pesquisar">
            {% render 'icon', name: 'search' %}
          </summary>
          <div class="manifesto-header__search-panel">
            <form action="{{ routes.search_url }}" method="get" role="search" class="manifesto-header__search-form">
              <input
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="O que você procura?"
                aria-label="Pesquisar produtos"
                class="field__input"
              >
              <button type="submit" class="manifesto-header__search-submit" aria-label="Enviar pesquisa">
                {% render 'icon', name: 'search' %}
              </button>
            </form>
          </div>
        </details>

        <a href="{{ routes.account_url }}" class="manifesto-header__action tap-target" aria-label="Minha conta">
          {% render 'icon', name: 'account' %}
        </a>

        <a href="{{ routes.cart_url }}" class="manifesto-header__action manifesto-header__cart tap-target" aria-label="Carrinho">
          {% render 'icon', name: 'cart' %}
          {%- if cart.item_count > 0 -%}
            <span class="manifesto-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
          {%- else -%}
            <span class="manifesto-header__cart-count" data-cart-count hidden>0</span>
          {%- endif -%}
        </a>
      </div>
    </div>

    <div class="manifesto-header__mobile-nav" id="MobileNav-{{ section.id }}" hidden>
      <ul class="manifesto-header__mobile-menu page-width" role="list">
        {%- for block in section.blocks -%}
          <li>
            {%- assign manifesto_label_downcase = block.settings.label | downcase -%}
            {%- assign manifesto_item_url = block.settings.link | default: routes.root_url -%}
            {%- if manifesto_label_downcase contains 'contato' -%}
              {%- assign manifesto_item_url = manifesto_contact_url -%}
            {%- endif -%}
            <a href="{{ manifesto_item_url }}" class="manifesto-header__mobile-link">
              {{ block.settings.label | escape }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </header>
</div>

<style>
  .section-header { position: relative; z-index: 50; }

  .manifesto-topbar {
    width: 100%;
    overflow: hidden;
    color: #fff;
    background: #000;
    border-bottom: 1px solid #171717;
  }

  .manifesto-topbar__track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: manifesto-topbar-{{ section.id }} 34s linear infinite;
  }

  .manifesto-topbar__item {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 14px 28px;
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .manifesto-topbar__dot { color: #7c7c7c; font-size: 12px; }

  @keyframes manifesto-topbar-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .manifesto-header {
    width: 100%;
    color: #000;
    background: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid #e9e9e9;
  }

  .manifesto-header__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: 82px;
    gap: 28px;
  }

  .manifesto-header__nav { justify-self: start; }
  .manifesto-header__menu {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 34px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .manifesto-header__menu-link {
    display: inline-block;
    padding: 10px 0;
    color: #000;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .manifesto-header__menu-link::after {
    content: '';
    display: block;
    width: 0;
    height: 1px;
    margin-top: 7px;
    background: #000;
    transition: width 0.2s ease;
  }
  .manifesto-header__menu-link:hover::after,
  .manifesto-header__menu-link:focus-visible::after { width: 100%; }

  .manifesto-header__logo-link {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #000;
    text-decoration: none;
  }

  .manifesto-header__logo-image {
    display: block;
    width: auto;
    max-width: min(260px, 28vw);
    height: auto;
    max-height: 64px;
    object-fit: contain;
  }

  .manifesto-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .manifesto-header__action {
    position: relative;
    color: #000;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-decoration: none;
  }
  .manifesto-header__action svg { width: 21px; height: 21px; }

  .manifesto-header__cart-count {
    position: absolute;
    top: 4px;
    right: 1px;
    display: grid;
    place-items: center;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    color: #fff;
    background: #000;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
  }

  .manifesto-header__search { position: relative; }
  .manifesto-header__search summary { list-style: none; }
  .manifesto-header__search summary::-webkit-details-marker { display: none; }
  .manifesto-header__search-panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: min(360px, 86vw);
    padding: 14px;
    background: #fff;
    border: 1px solid #e5e5e5;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
  }
  .manifesto-header__search-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
  .manifesto-header__search-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    color: #fff;
    background: #000;
    border: 1px solid #000;
    cursor: pointer;
  }
  .manifesto-header__search-submit svg { width: 18px; height: 18px; }

  .manifesto-header__menu-toggle {
    display: none;
    padding: 0;
    color: #000;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .manifesto-header__burger,
  .manifesto-header__burger::before,
  .manifesto-header__burger::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease;
    content: '';
  }
  .manifesto-header__burger::before { transform: translateY(-6px); }
  .manifesto-header__burger::after { transform: translateY(4px); }

  .manifesto-header__mobile-nav {
    border-top: 1px solid #efefef;
    background: #fff;
  }
  .manifesto-header__mobile-menu {
    margin: 0;
    padding-top: 10px;
    padding-bottom: 14px;
    list-style: none;
  }
  .manifesto-header__mobile-link {
    display: block;
    padding: 12px 0;
    color: #000;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media screen and (max-width: 1000px) {
    .manifesto-header__inner {
      grid-template-columns: auto 1fr auto;
      min-height: 72px;
      gap: 12px;
    }
    .manifesto-header__menu-toggle { display: inline-flex; }
    .manifesto-header__nav { display: none; }
    .manifesto-header__logo-link { justify-self: start; }
    .manifesto-header__logo-image { max-width: 160px; max-height: 42px; }
    .manifesto-header__actions { gap: 0; }
    .manifesto-topbar__item { padding: 12px 20px; font-size: 9px; letter-spacing: 0.16em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-topbar__track { animation-play-state: paused; }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var toggle = section.querySelector('.manifesto-header__menu-toggle');
    var mobileNav = section.querySelector('.manifesto-header__mobile-nav');
    if (!toggle || !mobileNav) return;
    toggle.addEventListener('click', function () {
      var expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      mobileNav.hidden = expanded;
    });
  })();
</script>

{% schema %}
{
  "name": "Navegação",
  "tag": "section",
  "class": "section-header",
  "settings": [
    { "type": "checkbox", "id": "show_top_bar", "label": "Mostrar faixa superior", "default": true },
    {
      "type": "textarea",
      "id": "top_bar_text",
      "label": "Itens da faixa superior",
      "default": "5% OFF NO PIX|VISTA O QUE VOCÊ PENSA|FRETE GRÁTIS NAS CONDIÇÕES DA CAMPANHA|COMPRE 2 E LEVE 3"
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Item do menu",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Início" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Navegação" }]
}
{% endschema %}
