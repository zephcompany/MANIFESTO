<section class="manifesto-tracking" id="rastreio" data-section-id="{{ section.id }}">
  <div class="manifesto-tracking__hero page-width">
    <div class="manifesto-tracking__copy">
      <p class="manifesto-tracking__eyebrow">ACOMPANHE SUA ENTREGA</p>
      <h1 class="manifesto-tracking__title">Rastreie seu pedido</h1>
      <p class="manifesto-tracking__text">Assim que o pedido for enviado, você receberá o código de rastreio no e-mail. Se preferir, também pode falar com nosso atendimento para suporte.</p>

      <form class="manifesto-tracking__form" data-tracking-form>
        <div class="manifesto-tracking__field">
          <label for="TrackingOrder-{{ section.id }}">Número do pedido</label>
          <input id="TrackingOrder-{{ section.id }}" type="text" class="field__input" placeholder="#1001">
        </div>
        <div class="manifesto-tracking__field">
          <label for="TrackingEmail-{{ section.id }}">E-mail ou WhatsApp</label>
          <input id="TrackingEmail-{{ section.id }}" type="text" class="field__input" placeholder="Seu e-mail ou número">
        </div>
        <div class="manifesto-tracking__actions">
          <button type="submit" class="button">Consultar rastreio</button>
          {%- if section.settings.support_link != blank -%}
            <a href="{{ section.settings.support_link }}" class="button button--secondary">Preciso de ajuda</a>
          {%- else -%}
            <a href="/pages/contato" class="button button--secondary">Preciso de ajuda</a>
          {%- endif -%}
        </div>
        <p class="manifesto-tracking__notice" data-tracking-notice>Digite os dados acima. Depois vamos te redirecionar para o acompanhamento.</p>
      </form>
    </div>

    <div class="manifesto-tracking__card">
      <div class="manifesto-tracking__timeline">
        <div class="manifesto-tracking__step is-done">
          <strong>1. Pedido confirmado</strong>
          <span>Pagamento aprovado e pedido registrado.</span>
        </div>
        <div class="manifesto-tracking__step is-done">
          <strong>2. Em separação</strong>
          <span>Sua peça está sendo preparada com cuidado.</span>
        </div>
        <div class="manifesto-tracking__step is-active">
          <strong>3. Enviado</strong>
          <span>Você recebe o código de rastreio para acompanhar.</span>
        </div>
        <div class="manifesto-tracking__step">
          <strong>4. Entregue</strong>
          <span>Pedido finalizado no seu endereço.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="manifesto-tracking__info page-width">
    <div class="manifesto-tracking__info-card">
      <h2>Como funciona</h2>
      <ol>
        <li>Finalize sua compra normalmente.</li>
        <li>Quando o pedido for enviado, você receberá o código por e-mail.</li>
        <li>Use o botão acima para consultar o andamento.</li>
      </ol>
    </div>
    <div class="manifesto-tracking__info-card">
      <h2>Não encontrou o código?</h2>
      <p>Verifique a caixa de entrada, spam ou promoções. Se ainda não localizar, fale com nosso atendimento e informe seu nome e número do pedido.</p>
      {%- if section.settings.support_link != blank -%}
        <a href="{{ section.settings.support_link }}" class="manifesto-tracking__help-link">Falar com suporte</a>
      {%- else -%}
        <a href="/pages/contato" class="manifesto-tracking__help-link">Falar com suporte</a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .manifesto-tracking {
    padding: clamp(42px, 7vw, 82px) 0 clamp(70px, 9vw, 110px);
    background: #fff;
  }
  .manifesto-tracking__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: clamp(28px, 5vw, 60px);
    align-items: start;
  }
  .manifesto-tracking__eyebrow {
    margin: 0 0 12px;
    color: #666;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .manifesto-tracking__title {
    margin: 0 0 16px;
    font-size: clamp(38px, 6vw, 70px);
    line-height: .92;
    letter-spacing: -.04em;
    text-transform: uppercase;
  }
  .manifesto-tracking__text {
    max-width: 630px;
    margin: 0 0 28px;
    color: #666;
    font-size: 15px;
    line-height: 1.7;
  }
  .manifesto-tracking__form {
    padding: 24px;
    background: #fafafa;
    border: 1px solid #e8e8e8;
  }
  .manifesto-tracking__field + .manifesto-tracking__field { margin-top: 14px; }
  .manifesto-tracking__field label {
    display: block;
    margin-bottom: 7px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .manifesto-tracking__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .manifesto-tracking__actions .button { min-width: 210px; }
  .manifesto-tracking__notice {
    margin: 14px 0 0;
    color: #666;
    font-size: 12px;
    line-height: 1.6;
  }
  .manifesto-tracking__card {
    padding: 26px;
    background: #000;
    color: #fff;
  }
  .manifesto-tracking__timeline { display: grid; gap: 16px; }
  .manifesto-tracking__step {
    position: relative;
    padding: 18px 18px 18px 22px;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.12);
  }
  .manifesto-tracking__step::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 0;
    width: 4px;
    height: calc(100% - 44px);
    background: #3e3e3e;
  }
  .manifesto-tracking__step.is-done::before,
  .manifesto-tracking__step.is-active::before { background: #fff; }
  .manifesto-tracking__step strong {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .manifesto-tracking__step span { color: #b8b8b8; font-size: 13px; line-height: 1.6; }
  .manifesto-tracking__info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 20px;
  }
  .manifesto-tracking__info-card {
    padding: 24px;
    border: 1px solid #e9e9e9;
    background: #fafafa;
  }
  .manifesto-tracking__info-card h2 { margin: 0 0 12px; font-size: 24px; text-transform: uppercase; }
  .manifesto-tracking__info-card p,
  .manifesto-tracking__info-card li { color: #666; font-size: 14px; line-height: 1.7; }
  .manifesto-tracking__info-card ol { margin: 0; padding-left: 1.2em; }
  .manifesto-tracking__help-link {
    display: inline-block;
    margin-top: 10px;
    color: #000;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: underline;
  }
  @media screen and (max-width: 960px) {
    .manifesto-tracking__hero, .manifesto-tracking__info { grid-template-columns: 1fr; }
  }
  @media screen and (max-width: 749px) {
    .manifesto-tracking__form, .manifesto-tracking__card, .manifesto-tracking__info-card { padding: 18px; }
    .manifesto-tracking__actions { flex-direction: column; }
    .manifesto-tracking__actions .button { min-width: 0; width: 100%; }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var form = section.querySelector('[data-tracking-form]');
    var notice = section.querySelector('[data-tracking-notice]');
    if (!form) return;
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var order = section.querySelector('#TrackingOrder-{{ section.id }}').value.trim();
      var email = section.querySelector('#TrackingEmail-{{ section.id }}').value.trim();
      if (!order || !email) {
        notice.textContent = 'Preencha o número do pedido e seu e-mail ou WhatsApp para continuar.';
        return;
      }
      {%- if section.settings.tracking_url != blank -%}
        window.open('{{ section.settings.tracking_url }}', '_blank');
        notice.textContent = 'Abrimos a página de acompanhamento em uma nova aba.';
      {%- else -%}
        notice.textContent = 'Seu pedido já foi registrado. Assim que ele for enviado, o código de rastreio será encaminhado por e-mail.';
      {%- endif -%}
    });
  })();
</script>
