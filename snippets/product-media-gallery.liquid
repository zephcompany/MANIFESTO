
<style>
  .section-main-product .product {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
    align-items: start;
    gap: clamp(26px, 4vw, 56px);
    padding-top: var(--spacing-sections);
    padding-bottom: var(--spacing-sections);
  }
  .product__gallery { display: flex; flex-direction: column; gap: 12px; }
  .product__gallery-stage { position: relative; width: 100%; }
  .product__media-wrapper { width: 100%; min-width: 0; }
  .product__media-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    border: 1px solid var(--color-border, #e5e5e5);
    background: #f7f7f7;
  }
  .product__media-list::-webkit-scrollbar { display: none; }
  .product__media-item {
    width: 100%;
    scroll-snap-align: start;
    overflow: hidden;
    background-color: var(--color-background-contrast);
  }
  .product__media-item img,
  .product__media-item iframe,
  .product__media-item video,
  .product__media-item model-viewer {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    height: auto;
  }
  .product__gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    color: #000;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid #ddd;
    cursor: pointer;
    font-size: 28px;
    line-height: 1;
  }
  .product__gallery-nav--prev { left: 14px; }
  .product__gallery-nav--next { right: 14px; }
  .product__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(68px, 1fr));
    gap: 10px;
    margin-top: 12px;
  }
  .product__thumb {
    display: block;
    padding: 0;
    background: #fff;
    border: 1px solid #d5d5d5;
    cursor: pointer;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .product__thumb.is-active { border-color: #000; }
  .product__thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .product__info { width: 100%; min-width: 0; }
  .product__vendor {
    font-size: 12px;
    color: var(--color-text);
    opacity: 0.7;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .product__title {
    margin: 0 0 18px;
    font-size: clamp(24px, 3.4vw, 38px);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .product__price { margin-bottom: 20px; }
  .product__description { margin: 24px 0; line-height: 1.7; color: #4d4d4d; }
  .product__option { border: 0; padding: 0; margin: 0 0 20px; }
  .product__option-name { display: block; font-size: 12px; margin-bottom: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .product__swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 14px;
    margin: 0 8px 8px 0;
    border: 1px solid #d0d0d0;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .product__swatch.is-selected { border-color: #000; border-width: 2px; }
  .product__swatch.is-unavailable { opacity: 0.4; }
  .product__swatch-color,
  .product__swatch-media { width: 28px; height: 28px; border-radius: 50%; background-size: cover; background-position: center; display: block; }
  .product__quantity { margin: 20px 0; }
  .quantity-selector { display: inline-flex; align-items: center; border: 1px solid #d0d0d0; overflow: hidden; }
  .quantity__button { width: 44px; height: 44px; background: none; border: none; cursor: pointer; font-size: 24px; }
  .quantity__input { width: 56px; height: 44px; text-align: center; border: none; -moz-appearance: textfield; font-size: 15px; }
  .quantity__input::-webkit-outer-spin-button,
  .quantity__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .product__buy-buttons { margin: 24px 0; }
  .product__add-to-cart,
  .product__buy-now { width: 100%; min-height: 56px; }
  .product__add-to-cart { margin-bottom: 10px; }
  .product__buy-now {
    color: #000;
    background: #fff;
    border-color: #000;
  }
  .product__buy-now:hover { color: #fff; background: #000; opacity: 1; }
  .product__share { margin-top: 20px; }
  .price { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 28px; font-weight: 800; }
  .price__compare { opacity: 0.45; font-size: 15px; }
  .price__badge { font-size: 10px; padding: 4px 8px; color: #fff; background-color: #000; text-transform: uppercase; }

  @media screen and (max-width: 1000px) {
    .section-main-product .product { grid-template-columns: 1fr; gap: 24px; }
    .product__gallery-nav { width: 40px; height: 40px; font-size: 24px; }
  }

  @media screen and (max-width: 749px) {
    .section-main-product .product {
      padding-top: clamp(18px, 5vw, 28px);
      gap: 18px;
    }
    .product__gallery { gap: 12px; }
    .product__thumbs {
      order: -1;
      display: flex;
      align-items: flex-start;
      flex-wrap: nowrap;
      gap: 8px;
      margin-top: 0;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 2px;
    }
    .product__thumbs::-webkit-scrollbar { display: none; }
    .product__thumb {
      flex: 0 0 64px;
      width: 64px;
      min-width: 64px;
      max-width: 64px;
      height: 64px;
      min-height: 64px;
      max-height: 64px;
      border-width: 1px;
      aspect-ratio: 1 / 1;
      overflow: hidden;
    }
    .product__thumb.is-active { border-width: 2px; }
    .product__thumb img {
      width: 100%;
      height: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      object-position: center;
    }
    .product__gallery-stage,
    .product__media-list {
      width: 100%;
    }
    .product__gallery-nav {
      top: 50%;
      width: 42px;
      height: 42px;
      font-size: 24px;
      background: rgba(255,255,255,.94);
      transform: translateY(-50%);
    }
    .product__gallery-nav--prev { left: 10px; }
    .product__gallery-nav--next { right: 10px; }
  }
</style>

<script>
  (function () {
    var gallery = document.getElementById('ProductMedia-{{ section_id }}');
    if (!gallery) return;
    var track = gallery.querySelector('[data-product-track]');
    var slides = Array.prototype.slice.call(gallery.querySelectorAll('.product__media-item'));
    var thumbs = Array.prototype.slice.call(gallery.querySelectorAll('[data-thumb-target]'));
    var prev = gallery.querySelector('.product__gallery-nav--prev');
    var next = gallery.querySelector('.product__gallery-nav--next');
    if (!track || !slides.length) return;

    var currentIndex = 0;

    function setActive(index, shouldScroll) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;
      slides.forEach(function (slide, i) { slide.classList.toggle('is-active', i === index); });
      thumbs.forEach(function (thumb, i) {
        var isActive = i === index;
        thumb.classList.toggle('is-active', isActive);
        if (isActive) {
          try { thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' }); } catch (e) {}
        }
      });
      if (shouldScroll !== false) {
        track.scrollTo({ left: track.clientWidth * index, behavior: 'smooth' });
      }
    }

    gallery.setActiveMedia = function (mediaId) {
      var idx = slides.findIndex(function (slide) { return String(slide.getAttribute('data-media-id')) === String(mediaId); });
      if (idx > -1) setActive(idx);
    };

    thumbs.forEach(function (thumb, idx) {
      thumb.addEventListener('click', function () { setActive(idx); });
    });
    if (prev) prev.addEventListener('click', function () { setActive(currentIndex - 1); });
    if (next) next.addEventListener('click', function () { setActive(currentIndex + 1); });

    track.addEventListener('scroll', function () {
      var index = Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
      if (index !== currentIndex && index >= 0 && index < slides.length) {
        currentIndex = index;
        slides.forEach(function (slide, i) { slide.classList.toggle('is-active', i === index); });
        thumbs.forEach(function (thumb, i) {
          var isActive = i === index;
          thumb.classList.toggle('is-active', isActive);
          if (isActive) {
            try { thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' }); } catch (e) {}
          }
        });
      }
    }, { passive: true });

    setActive(0, false);
  })();
</script>
