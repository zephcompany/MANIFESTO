{%- liquid
  assign ratio = 0.8
  case settings.card_image_ratio
    when 'square'
      assign ratio = 1
    when 'adapt'
      if card_product.featured_media
        assign ratio = card_product.featured_media.aspect_ratio
      endif
  endcase

  assign pix_discount = pix_discount | default: 5
  assign selected_variant = card_product.selected_or_first_available_variant
  assign current_price = card_product.price_min
  assign compare_price = card_product.compare_at_price_max
  assign on_sale = false
  assign discount_percent = 0

  if compare_price > current_price
    assign on_sale = true
    assign discount_value = compare_price | minus: current_price
    assign discount_percent = discount_value | times: 100.0 | divided_by: compare_price | round
  endif

  assign pix_multiplier = 100 | minus: pix_discount
  assign pix_price = current_price | times: pix_multiplier | divided_by: 100
-%}

<article class="manifesto-product-card" data-manifesto-product-card>
  <a href="{{ card_product.url }}" class="manifesto-product-card__media-link" data-card-product-link aria-label="{{ card_product.title | escape }}">
    <div class="manifesto-product-card__media" style="--card-ratio: {{ ratio }};">
      {%- if card_product.featured_media -%}
        {{
          card_product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            class: 'manifesto-product-card__image manifesto-product-card__image--primary',
            widths: '220, 360, 520, 720, 900',
            sizes: '(min-width: 1100px) 25vw, (min-width: 650px) 50vw, 85vw',
            alt: card_product.featured_media.alt | default: card_product.title | escape
        }}

        {%- if settings.card_show_second_image and card_product.media[1] -%}
          {{
            card_product.media[1]
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              class: 'manifesto-product-card__image manifesto-product-card__image--secondary',
              widths: '220, 360, 520, 720, 900',
              sizes: '(min-width: 1100px) 25vw, (min-width: 650px) 50vw, 85vw',
              alt: card_product.media[1].alt | default: card_product.title | escape
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'manifesto-product-card__image placeholder-svg' }}
      {%- endif -%}

      {%- if on_sale -%}
        <span class="manifesto-product-card__badge">-{{ discount_percent }}%</span>
      {%- elsif card_product.available == false -%}
        <span class="manifesto-product-card__badge">ESGOTADO</span>
      {%- endif -%}

      <span class="manifesto-product-card__hover-label">VER PRODUTO</span>
    </div>
  </a>

  <div class="manifesto-product-card__content">
    <a href="{{ card_product.url }}" class="manifesto-product-card__title-link" data-card-product-link>
      <h3 class="manifesto-product-card__title">{{ card_product.title | escape }}</h3>
    </a>

    <div class="manifesto-product-card__price-row">
      {%- if on_sale -%}
        <s class="manifesto-product-card__compare">{{ compare_price | money }}</s>
      {%- endif -%}
      <span class="manifesto-product-card__price">{{ current_price | money }}</span>
    </div>

    {%- if pix_discount > 0 -%}
      <p class="manifesto-product-card__pix">
        <strong>{{ pix_price | money }}</strong> no Pix
        <span>{{ pix_discount }}% OFF</span>
      </p>
    {%- endif -%}

    {%- assign color_option_found = false -%}
    {%- for option in card_product.options_with_values -%}
      {%- assign option_name = option.name | downcase -%}
      {%- if option_name contains 'cor' or option_name contains 'color' -%}
        {%- assign color_option_found = true -%}
        {%- assign color_option_index = option.position | minus: 1 -%}
        <div class="manifesto-product-card__swatches" aria-label="Selecione uma cor">
          {%- for value in option.values limit: 8 -%}
            {%- liquid
              assign color_variant = nil
              for variant in card_product.variants
                if variant.options[color_option_index] == value and variant.available
                  assign color_variant = variant
                  break
                endif
              endfor

              if color_variant == nil
                for variant in card_product.variants
                  if variant.options[color_option_index] == value
                    assign color_variant = variant
                    break
                  endif
                endfor
              endif

              assign variant_image = color_variant.featured_media.preview_image | default: card_product.featured_media.preview_image
              assign variant_image_url = variant_image | image_url: width: 900
              assign variant_url = card_product.url | append: '?variant=' | append: color_variant.id
              assign is_selected = false
              if selected_variant.options[color_option_index] == value
                assign is_selected = true
              endif
              assign color_value = value | downcase | strip
            -%}

            {%- capture swatch_color -%}
              {%- case color_value -%}
                {%- when 'preto' -%}#111111
                {%- when 'branco' -%}#ffffff
                {%- when 'off white' -%}#f3f0e8
                {%- when 'off-white' -%}#f3f0e8
                {%- when 'cinza' -%}#9a9a9a
                {%- when 'cinza chumbo' -%}#444444
                {%- when 'bege' -%}#cbbb9f
                {%- when 'marrom' -%}#65483d
                {%- when 'azul' -%}#1f4d8c
                {%- when 'azul marinho' -%}#17233f
                {%- when 'verde' -%}#3f5d45
                {%- when 'vermelho' -%}#a52a2a
                {%- when 'black' -%}#111111
                {%- when 'white' -%}#ffffff
                {%- when 'gray' -%}#9a9a9a
                {%- when 'grey' -%}#9a9a9a
                {%- when 'navy' -%}#17233f
                {%- when 'blue' -%}#1f4d8c
                {%- when 'green' -%}#3f5d45
                {%- when 'red' -%}#a52a2a
                {%- when 'brown' -%}#65483d
                {%- when 'beige' -%}#cbbb9f
                {%- else -%}#d9d9d9
              {%- endcase -%}
            {%- endcapture -%}

            <button
              type="button"
              class="manifesto-product-card__swatch{% if is_selected %} is-selected{% endif %}{% unless color_variant.available %} is-unavailable{% endunless %}"
              aria-label="Selecionar cor {{ value | escape }}"
              aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
              title="{{ value | escape }}"
              style="--swatch: {{ swatch_color | strip }};"
              data-color-swatch
              data-image-url="{{ variant_image_url }}"
              data-variant-url="{{ variant_url }}"
              data-available="{{ color_variant.available }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- unless color_option_found -%}
      <div class="manifesto-product-card__swatches manifesto-product-card__swatches--empty" aria-hidden="true"></div>
    {%- endunless -%}

    <a
      href="{{ card_product.url }}"
      class="manifesto-product-card__button {% unless card_product.available %}manifesto-product-card__button--disabled{% endunless %}"
      data-card-buy-link
      {% unless card_product.available %}aria-disabled="true"{% endunless %}
    >
      {%- if card_product.available -%}COMPRAR{%- else -%}ESGOTADO{%- endif -%}
    </a>
  </div>
</article>

<script>
  (function () {
    var script = document.currentScript;
    var card = script && script.previousElementSibling;
    if (!card || !card.matches('[data-manifesto-product-card]')) return;

    var swatches = card.querySelectorAll('[data-color-swatch]');
    if (!swatches.length) return;

    var primaryImage = card.querySelector('.manifesto-product-card__image--primary');
    var secondaryImage = card.querySelector('.manifesto-product-card__image--secondary');
    var productLinks = card.querySelectorAll('[data-card-product-link]');
    var buyLink = card.querySelector('[data-card-buy-link]');

    swatches.forEach(function (swatch) {
      swatch.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        swatches.forEach(function (item) {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });
        swatch.classList.add('is-selected');
        swatch.setAttribute('aria-pressed', 'true');

        var imageUrl = swatch.getAttribute('data-image-url');
        if (imageUrl && primaryImage) {
          primaryImage.removeAttribute('srcset');
          primaryImage.removeAttribute('sizes');
          primaryImage.src = imageUrl;
          if (secondaryImage) {
            secondaryImage.removeAttribute('srcset');
            secondaryImage.removeAttribute('sizes');
            secondaryImage.src = imageUrl;
          }
          card.classList.add('has-selected-color');
        }

        var variantUrl = swatch.getAttribute('data-variant-url');
        if (variantUrl) {
          productLinks.forEach(function (link) { link.href = variantUrl; });
          if (buyLink) buyLink.href = variantUrl;
        }

        if (buyLink) {
          var available = swatch.getAttribute('data-available') === 'true';
          buyLink.textContent = available ? 'COMPRAR' : 'ESGOTADO';
          buyLink.classList.toggle('manifesto-product-card__button--disabled', !available);
          if (available) buyLink.removeAttribute('aria-disabled');
          else buyLink.setAttribute('aria-disabled', 'true');
        }
      });
    });
  })();
</script>
